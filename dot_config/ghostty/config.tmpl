# GENERATED BY CHEZMOI - {{ .chezmoi.hostname }}

# --- Color Theme ---
# Dynamic: always follow whatever Omarchy theme is currently active
# (mirrors the `include=` line Omarchy's foot.ini uses).
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# --- Terminal Emulation ---
# We comment this out to let the system/Ghostty default to its official terminfo.
# If you run into issues on older remote servers, use the 'px' or 'fix-term' aliases.
# term = xterm-ghostty

# --- Font Configuration ---
# Standardize on Nerd Fonts across all platforms to support Starship/Eza icons
font-family = "JetBrainsMono Nerd Font"
font-style = Regular

# Deliberately decoupled from `omarchy display text size` (12px shell there
# would anchor this to 9pt): 12px shell is the comfortable UI size, but its
# 9pt terminal anchor is too small, so this is pinned to 11pt independently.
# Touching that slider/CLI again will silently overwrite this back down to
# its anchor value -- rerun ~/.local/bin/fix-terminal-font-size to restore.
font-size = 11

# --- Window ---
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never

# --- Cursor styling ---
cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor

# --- Keyboard bindings ---
keybind = f11=toggle_fullscreen
keybind = super+v=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# --- Scrolling ---
mouse-scroll-multiplier = 0.95

# --- Role Specifics ---
# Adjust opacity for focus vs. mobility
{{- if eq .role "laptop" }}
# Better battery/performance/readability for laptop screens
background-opacity = 0.95
{{- else }}
background-opacity = 1.0
{{- end }}
