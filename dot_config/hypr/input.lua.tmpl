-- GENERATED BY CHEZMOI - {{ .chezmoi.hostname }} ({{ .role }})
-- Keep only your personal input overrides here. Uncommented settings below
-- replace Omarchy's defaults.
-- See https://wiki.hypr.land/Configuring/Basics/Variables/#input

hl.config({
  input = {
    kb_options = "compose:caps,altwin:swap_lalt_lwin",

    repeat_rate = 40,
    repeat_delay = 600,

    touchpad = {
      -- Enable natural scroll for all machines with touchpads.
      natural_scroll = true,
      scroll_factor = 0.4,
      disable_while_typing = true,
      middle_button_emulation = false,
      tap_and_drag = false,
      clickfinger_behavior = true,
    },
  },
})

-- --- Machine-Specific Keyboard Overrides ---
{{- if eq .chezmoi.hostname "lg-gram-omarchy" }}
hl.config({ input = { kb_options = "compose:caps,win:super,altwin:swap_alt_win" } })
{{- else if eq .chezmoi.hostname "red-chromebook-omarchy" }}
-- Samsung Galaxy Chromebook2 with Search->Alt remapping.
hl.config({ input = { kb_options = "compose:caps,altwin:ctrl_lwin,lwin:super,caps:alt" } })
{{- end }}

-- Enable natural scrolling for all mice too.
hl.device({ name = "mouse", natural_scroll = true })
