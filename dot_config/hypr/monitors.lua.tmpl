-- GENERATED BY CHEZMOI - {{ .chezmoi.hostname }} ({{ .role }})
-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- --- Host-Specific Overrides ---
{{- if eq .chezmoi.hostname "geekom-a8-desktop" }}

-- Primary monitor: LG UltraFine, unrotated.
-- Matched by description (not DP-N port name): the DP port index can shift
-- after sleep/resume, which was silently dropping this override and the
-- rotation below.
hl.monitor({ output = "desc:LG Electronics LG ULTRAFINE 605INBS2H205", mode = "3840x2160@60", position = "0x0", scale = 1.33, transform = 0 })

-- Secondary monitor: LG HDR 4K, rotated 90° clockwise (transform: 1 = 90°, 3 = 270°).
hl.monitor({ output = "desc:LG Electronics LG HDR 4K 0x00060B07", mode = "3840x2160@60", position = "auto", scale = 1.33, transform = 1 })

-- Pin workspaces to monitors. Matched by description for the same reason as
-- the monitor overrides above (DP-N port names can shift after sleep/resume).
-- Workspace-to-app pins live in hypr/windows.lua (not host-specific).
hl.workspace_rule({ workspace = "1", monitor = "desc:LG Electronics LG ULTRAFINE 605INBS2H205" })
hl.workspace_rule({ workspace = "2", monitor = "desc:LG Electronics LG ULTRAFINE 605INBS2H205" })
hl.workspace_rule({ workspace = "3", monitor = "desc:LG Electronics LG ULTRAFINE 605INBS2H205" })
hl.workspace_rule({ workspace = "4", monitor = "desc:LG Electronics LG ULTRAFINE 605INBS2H205" })
hl.workspace_rule({ workspace = "5", monitor = "desc:LG Electronics LG HDR 4K 0x00060B07" })

{{- else if eq .chezmoi.hostname "lg-gram-omarchy" }}

-- LG Gram (1080p) - keep at 1x for sharpness.
hl.monitor({ output = "eDP-1", mode = "1920x1080@60", position = "0x0", scale = 1 })

{{- else if eq .chezmoi.hostname "red-chromebook-omarchy" }}

-- Samsung Galaxy Chromebook2 specifics.
hl.monitor({ output = "eDP-1", mode = "1920x1080@60", position = "0x0", scale = 1 })

{{- else if eq .chezmoi.hostname "beelink-desktop-omarchy" }}

-- Beelink 4K desktop scaling.
hl.env("GDK_SCALE", "1.25")
hl.env("XCURSOR_SIZE", "32")
hl.monitor({ output = "", mode = "3840x2160@60", position = "auto", scale = 1.25 })

{{- end }}
