-- GENERATED BY CHEZMOI - {{ .chezmoi.hostname }} ({{ .role }})
-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- --- Host-Specific Overrides ---
{{- if eq .chezmoi.hostname "geekom-a8-desktop" }}

-- Primary monitor: LG UltraFine, unrotated.
hl.monitor({ output = "DP-8", mode = "3840x2160@60", position = "0x0", scale = 1.25, transform = 0 })

-- Secondary monitor: LG HDR 4K, rotated 90° clockwise (transform: 1 = 90°, 3 = 270°).
hl.monitor({ output = "DP-11", mode = "3840x2160@60", position = "auto", scale = 1.25, transform = 1 })

{{- else if eq .chezmoi.hostname "lg-gram-omarchy" }}

-- LG Gram (1080p) - keep at 1x for sharpness.
hl.monitor({ output = "eDP-1", mode = "1920x1080@60", position = "0x0", scale = 1 })

{{- else if eq .chezmoi.hostname "red-chromebook-omarchy" }}

-- Samsung Galaxy Chromebook2 specifics.
hl.monitor({ output = "eDP-1", mode = "1920x1080@60", position = "0x0", scale = 1 })

{{- else if eq .chezmoi.hostname "beelink-desktop-omarchy" }}

-- Beelink 4K desktop scaling.
hl.env("GDK_SCALE", "1.25")
hl.env("XCURSOR_SIZE", "32")
hl.monitor({ output = "", mode = "3840x2160@60", position = "auto", scale = 1.25 })

{{- end }}
